  | {"definition":"{\n  \"Comment\": \"Hermes approval-flow v1 — submit -> humanReview -> Choice(approved/denied) -> notify\",\n  \"StartAt\": \"SubmitRequest\",\n  \"States\": {\n    \"SubmitRequest\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke.waitForTaskToken\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:123456789012:function:hermes-dev-submit-worker\",\n        \"Payload\": {\n          \"executionId.$\": \"$.executionId\",\n          \"tenantId.$\": \"$.tenantId\",\n          \"stepName\": \"submit\",\n          \"requestData.$\": \"$.requestData\",\n          \"taskToken.$\": \"$$.Task.Token\"\n        }\n      },\n      \"ResultPath\": \"$.submitOutput\",\n      \"Next\": \"HumanReview\"\n    },\n    \"HumanReview\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke.waitForTaskToken\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:123456789012:function:hermes-dev-human-gate-worker\",\n        \"Payload\": {\n          \"executionId.$\": \"$.executionId\",\n          \"tenantId.$\": \"$.tenantId\",\n          \"stepName\": \"humanReview\",\n          \"approverGroup\": \"FINANCE_MANAGERS\",\n          \"taskToken.$\": \"$$.Task.Token\"\n        }\n      },\n      \"ResultPath\": \"$.reviewResult\",\n      \"Next\": \"CheckApprovalStatus\"\n    },\n    \"CheckApprovalStatus\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.reviewResult.approved\",\n          \"BooleanEquals\": true,\n          \"Next\": \"NotifyApproval\"\n        }\n      ],\n      \"Default\": \"NotifyRejection\"\n    },\n    \"NotifyApproval\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:123456789012:function:hermes-dev-notify-worker\",\n        \"Payload\": {\n          \"executionId.$\": \"$.executionId\",\n          \"tenantId.$\": \"$.tenantId\",\n          \"status\": \"APPROVED\",\n          \"reviewResult.$\": \"$.reviewResult\"\n        }\n      },\n      \"Next\": \"ApprovedSuccess\"\n    },\n    \"NotifyRejection\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:123456789012:function:hermes-dev-notify-worker\",\n        \"Payload\": {\n          \"executionId.$\": \"$.executionId\",\n          \"tenantId.$\": \"$.tenantId\",\n          \"status\": \"REJECTED\",\n          \"reviewResult.$\": \"$.reviewResult\"\n        }\n      },\n      \"Next\": \"RejectedState\"\n    },\n    \"ApprovedSuccess\": {\n      \"Type\": \"Succeed\"\n    },\n    \"RejectedState\": {\n      \"Type\": \"Fail\",\n      \"Error\": \"RequestRejected\",\n      \"Cause\": \"Human review rejected the submitted request\"\n    }\n  }\n}\n","type":"STANDARD"}
