  | {"definition":"{\n  \"Comment\": \"Hermes batch-etl v1 — ingestBatch -> Map(ItemTransform) -> validateBatch -> loadToWarehouse\",\n  \"StartAt\": \"IngestBatch\",\n  \"States\": {\n    \"IngestBatch\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke.waitForTaskToken\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:123456789012:function:hermes-dev-ingest-worker\",\n        \"Payload\": {\n          \"executionId.$\": \"$.executionId\",\n          \"tenantId.$\": \"$.tenantId\",\n          \"batchId.$\": \"$.batchId\",\n          \"s3SourceKey.$\": \"$.s3SourceKey\",\n          \"taskToken.$\": \"$$.Task.Token\"\n        }\n      },\n      \"ResultPath\": \"$.ingestOutput\",\n      \"Next\": \"ProcessBatchItems\"\n    },\n    \"ProcessBatchItems\": {\n      \"Type\": \"Map\",\n      \"ItemsPath\": \"$.ingestOutput.items\",\n      \"MaxConcurrency\": 10,\n      \"Iterator\": {\n        \"StartAt\": \"TransformItem\",\n        \"States\": {\n          \"TransformItem\": {\n            \"Type\": \"Task\",\n            \"Resource\": \"arn:aws:states:::lambda:invoke\",\n            \"Parameters\": {\n              \"FunctionName\": \"arn:aws:lambda:us-east-1:123456789012:function:hermes-dev-transform-worker\",\n              \"Payload\": {\n                \"item.$\": \"$\",\n                \"executionId.$\": \"$.executionId\"\n              }\n            },\n            \"End\": true\n          }\n        }\n      },\n      \"ResultPath\": \"$.transformedItems\",\n      \"Next\": \"ValidateBatch\"\n    },\n    \"ValidateBatch\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke.waitForTaskToken\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:123456789012:function:hermes-dev-validate-batch-worker\",\n        \"Payload\": {\n          \"executionId.$\": \"$.executionId\",\n          \"items.$\": \"$.transformedItems\",\n          \"taskToken.$\": \"$$.Task.Token\"\n        }\n      },\n      \"ResultPath\": \"$.validationOutput\",\n      \"Next\": \"LoadToWarehouse\"\n    },\n    \"LoadToWarehouse\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke.waitForTaskToken\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:123456789012:function:hermes-dev-load-worker\",\n        \"Payload\": {\n          \"executionId.$\": \"$.executionId\",\n          \"tenantId.$\": \"$.tenantId\",\n          \"data.$\": \"$.validationOutput\",\n          \"taskToken.$\": \"$$.Task.Token\"\n        }\n      },\n      \"ResultPath\": \"$.loadOutput\",\n      \"Next\": \"BatchSuccess\"\n    },\n    \"BatchSuccess\": {\n      \"Type\": \"Succeed\"\n    }\n  }\n}\n","type":"STANDARD"}
