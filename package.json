{
  "name": "hermes",
  "version": "1.0.0",
  "private": true,
  "description": "Event-sourced workflow orchestration platform",
  "workspaces": [
    "shared/*",
    "services/lambda-workers/*",
    "services/event-projections/*",
    "services/activity-workers/*",
    "services/command-api",
    "services/query-api"
  ],
  "scripts": {
    "build": "npm run build -w @hermes/domain && npm run build -w @hermes/observability && npm run build -w @hermes/event-store && npm run build -w @hermes/command-handlers && npm run build -w @hermes/activity-runner && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test --workspaces --if-present -- --experimental-test-coverage",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:load": "node --import tsx scripts/load-test.ts"
  },
  
  "devDependencies": {
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
